{
  "version": 2,
  "buildCommand": "npm install && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "framework": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization,X-CSRF-Token,X-API-Key,X-Request-Id,X-Request-Timestamp" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://api.qrserver.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/tiny-secp256k1/lib/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production",
    "CI": "false",
    "REACT_APP_API_URL": "https://crypto-wallet-blush-beta.vercel.app/api",
    "REACT_APP_SUPABASE_URL": "https://dselsgxfkjwkwyngenxp.supabase.co",
    "REACT_APP_SUPABASE_ANON_KEY": "sb_publishable_2DDlTKUYtPnTXhOlRbnK7A_isSVVNTK",
    "SUPABASE_URL": "https://dselsgxfkjwkwyngenxp.supabase.co",
    "SUPABASE_SERVICE_ROLE_KEY": "SET_IN_VERCEL_DASHBOARD",
